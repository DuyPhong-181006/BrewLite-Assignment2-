{
  "info": {
    "name": "BrewLite – Đơn hàng (TV4 Phạm Thành Danh)",
    "description": "Chạy backend (cổng 3001), CSDL đã seed, apps/api/.env có JWT_SECRET. Bấm Run collection để chạy lần lượt 1 → 22. Request 1 đăng nhập tài khoản demo và lưu token; các request sau tự gửi kèm token. Có kiểm tra tồn kho: đặt đơn trừ kho, hủy đơn trả kho, đặt quá kho bị chặn.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Đăng nhập tài khoản demo (lấy token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@brewlite.vn\",\n  \"password\": \"123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Đăng nhập thành công\", () => pm.expect([200, 201]).to.include(pm.response.code));",
              "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
