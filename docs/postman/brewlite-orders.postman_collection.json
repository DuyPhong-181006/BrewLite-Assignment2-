    {
      "name": "4. Tạo đơn hợp lệ (Cappuccino M + trân châu x2)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": 3,\n      \"size\": \"M\",\n      \"toppings\": [\n        \"PEARL\"\n      ],\n      \"qty\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Mã trạng thái 201\", () => pm.response.to.have.status(201));",
              "const o = pm.response.json();",
              "pm.test(\"Đơn ở trạng thái PENDING\", () => pm.expect(o.status).to.eql(\"PENDING\"));",
              "pm.test(\"Giá 1 ly do backend tính = 45000 + 5000 + 5000 = 55000\", () => pm.expect(o.items[0].unitPrice).to.eql(55000));",
              "pm.test(\"Tổng = 55000 x 2 = 110000\", () => pm.expect(o.total).to.eql(110000));",
              "pm.collectionVariables.set(\"orderId\", o.id);"
            ]
          }
        }
      ]
    },
