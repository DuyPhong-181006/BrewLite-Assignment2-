    {
      "name": "12. Tạo đơn có mã WELCOME10 (giảm 10%, tối đa 20.000đ)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": 3,\n      \"size\": \"M\",\n      \"toppings\": [\n        \"PEARL\"\n      ],\n      \"qty\": 2\n    }\n  ],\n  \"couponCode\": \"WELCOME10\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Mã trạng thái 201\", () => pm.response.to.have.status(201));",
              "const o = pm.response.json();",
              "pm.test(\"Tạm tính 110000\", () => pm.expect(o.subtotal).to.eql(110000));",
              "pm.test(\"Giảm 10% = 11000\", () => pm.expect(o.discount).to.eql(11000));",
              "pm.test(\"Tổng = 110000 - 11000 = 99000\", () => pm.expect(o.total).to.eql(99000));",
              "pm.test(\"Lưu mã đã dùng\", () => pm.expect(o.couponCode).to.eql(\"WELCOME10\"));"
            ]
          }
        }
      ]
    },
