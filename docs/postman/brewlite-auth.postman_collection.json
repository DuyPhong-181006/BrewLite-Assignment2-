    {
      "name": "6. Đăng nhập tài khoản vừa tạo (lấy token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{regEmail}}\",\n  \"password\": \"matkhau123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Đăng nhập thành công\", () => pm.expect([200, 201]).to.include(pm.response.code));",
              "const b = pm.response.json();",
              "pm.test(\"Có accessToken (JWT)\", () => pm.expect(b.accessToken).to.be.a(\"string\").and.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/));",
              "pm.test(\"tokenType = Bearer\", () => pm.expect(b.tokenType).to.eql(\"Bearer\"));",
              "pm.test(\"Phản hồi dưới 500ms (đề Mục 4.2)\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
              "pm.collectionVariables.set(\"token\", b.accessToken);"
            ]
          }
        }
      ]
    },
