{
  "info": {
    "name": "BrewLite – Tài khoản & Điểm thưởng (TV5 An Tường)",
    "description": "Chạy backend (cổng 3001), CSDL đã seed, apps/api/.env có JWT_SECRET. Bấm Run collection để chạy lần lượt 1 → 14. Request 1 tự sinh email mới nên chạy lại bao nhiêu lần cũng được; request 6 đăng nhập và lưu token, các request sau tự gửi kèm token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Đăng ký tài khoản mới (email tự sinh)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{regEmail}}\",\n  \"password\": \"matkhau123\",\n  \"name\": \"Khách Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"regEmail\", \"khach\" + Date.now() + \"@brewlite.vn\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Mã trạng thái 201\", () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test(\"Báo đăng ký thành công\", () => pm.expect(b.message).to.eql(\"Đăng ký thành công\"));",
              "pm.test(\"Email được lưu chữ thường\", () => pm.expect(b.user.email).to.eql(pm.collectionVariables.get(\"regEmail\").toLowerCase()));",
              "pm.test(\"KHÔNG trả mật khẩu / mật khẩu đã băm\", () => { pm.expect(b.user).to.not.have.property(\"password\"); pm.expect(b.user).to.not.have.property(\"passwordHash\"); });",
              "pm.test(\"Điểm thưởng ban đầu = 0\", () => pm.expect(b.user.loyaltyPoints).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Lỗi: đăng ký trùng email -> 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
