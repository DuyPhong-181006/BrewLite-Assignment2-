        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{regEmail}}\",\n  \"password\": \"matkhau123\",\n  \"name\": \"Khách Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Mã trạng thái 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Báo email đã đăng ký\", () => pm.expect(pm.response.json().message).to.eql(\"Email đã được đăng ký\"));"
            ]
          }
        }
      ]
    },
