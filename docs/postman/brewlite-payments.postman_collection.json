{
  "info": {
    "name": "BrewLite – Thanh toán (TV6 Nguyễn Tấn Sự)",
    "description": "Chạy backend (cổng 3001), CSDL đã seed (docker compose up). Bấm Run collection để chạy lần lượt 1 → 20. Mỗi request thanh toán tự tạo Idempotency-Key mới trong tab Pre-request (biến payKey), riêng request \"Gửi lại CÙNG Idempotency-Key\" dùng lại key cũ để chứng minh chống trùng. Client chỉ gửi orderId + method (WALLET / CARD); số tiền do backend lấy từ tổng đơn. Request 1 đăng nhập tài khoản demo và lưu token; các request sau tự gửi kèm token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Đăng nhập tài khoản demo (lấy token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@brewlite.vn\",\n  \"password\": \"123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Đăng nhập thành công\", () => pm.expect([200, 201]).to.include(pm.response.code));",
              "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Tạo đơn để thanh toán (Cappuccino M x1)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": 3,\n      \"size\": \"M\",\n      \"qty\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Mã trạng thái 201\", () => pm.response.to.have.status(201));",
              "const o = pm.response.json();",
              "pm.test(\"Đơn đang PENDING (chờ thanh toán)\", () => pm.expect(o.status).to.eql(\"PENDING\"));",
              "pm.collectionVariables.set(\"orderId\", o.id);",
              "pm.collectionVariables.set(\"orderTotal\", o.total);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Lỗi: chưa đăng nhập (không có token) -> 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{payKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": {{orderId}},\n  \"method\": \"WALLET\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"payKey\", \"pm_\" + Date.now() + \"_\" + Math.floor(Math.random() * 1000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Mã trạng thái 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
