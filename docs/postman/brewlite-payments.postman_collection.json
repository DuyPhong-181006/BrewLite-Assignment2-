            "type": "text/javascript",
            "exec": [
              "pm.test(\"Mã trạng thái 201\", () => pm.response.to.have.status(201));",
              "const p = pm.response.json();",
              "pm.test(\"Giao dịch SUCCESS\", () => pm.expect(p.status).to.eql(\"SUCCESS\"));",
              "pm.test(\"Số tiền = tổng đơn do backend tính (client không gửi amount)\", () => pm.expect(p.amount).to.eql(Number(pm.collectionVariables.get(\"orderTotal\"))));",
              "pm.collectionVariables.set(\"paymentId\", p.id);"
            ]
          }
        }
      ]
