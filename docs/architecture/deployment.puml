@startuml deployment
' UML deployment diagram – môi trường production thực tế (Task 3.2) – TV1 Đào Duy Phong
' Nền tảng: Vercel (web) + Render (API, PostgreSQL) + GitHub Actions/GHCR (CI/CD). Xem ADR-006.
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam nodeBorderColor #2F6B4F
skinparam nodeBackgroundColor #FFFFFF
skinparam artifactBorderColor #A86B12
skinparam databaseBorderColor #2F6B4F
skinparam ArrowColor #2F6B4F
skinparam rectangleBorderColor #8AA9A0
skinparam rectangleBorderStyle dashed

rectangle "LOCAL – máy lập trình viên" as LOCAL {
  node "Laptop (Docker Desktop)" as DEV {
    artifact "docker-compose.yml\n(db + api + web)" as COMPOSE
    artifact "Git repo" as GIT
  }
}

rectangle "CI – GitHub" as CI {
  node "GitHub Repository\n(main được bảo vệ, PR bắt buộc)" as GH
  node "GitHub Actions runner\n(ubuntu-latest)" as RUNNER {
    artifact "ci.yml\nInstall → Lint → Unit Test → Build\n+ integration test" as CIWF
    artifact "e2e.yml (Playwright)" as E2EWF
    artifact "cd.yml / rollback.yml" as CDWF
  }
  node "GitHub Container Registry\nghcr.io/<owner>/brewlite-api" as GHCR {
    artifact "image :<commit-sha>\nimage :latest" as IMG
  }
  database "GitHub Secrets\nRENDER_DEPLOY_HOOK_URL\nVERCEL_TOKEN / ORG_ID / PROJECT_ID" as SECRETS
}

rectangle "PRODUCTION" as PROD {
  node "Thiết bị người dùng\n(điện thoại / laptop)" as DEVICE {
    node "Trình duyệt / PWA\n(manifest, cài lên màn hình chính)" as BROWSER
  }
  node "Vercel Edge Network (CDN)\nbrewlite.vercel.app" as VERCEL {
    artifact "Next.js 16 – apps/web\n(trang tĩnh + JS, NEXT_PUBLIC_API_URL)" as WEB
  }
  node "Render – Web Service (Docker)\nbrewlite-api.onrender.com, Singapore" as RENDER {
    node "Container node:22-alpine\ncổng 3001 (nội bộ)" as CONTAINER {
      artifact "NestJS API – apps/api\nGET /health, log stdout" as API
      artifact "prisma migrate deploy\n(chạy khi khởi động)" as MIG
    }
    database "Environment (Render)\nDATABASE_URL, JWT_SECRET,\nFRONTEND_URL, RUN_SEED" as ENV
  }
  node "Render PostgreSQL 16\n(Singapore, private network)" as PG {
    database "brewlite\n(persistent disk)" as DB
  }
}

DEV --> GH : git push / Pull Request\n(HTTPS 443)
GH --> RUNNER : kích hoạt workflow
CDWF --> GHCR : docker push\n(HTTPS 443)
CDWF ..> SECRETS : đọc secret
CDWF --> RENDER : gọi Deploy Hook ?imgURL=…:<sha>\n(HTTPS 443)
CDWF --> VERCEL : vercel deploy --prebuilt\n(HTTPS 443)
CDWF --> API : smoke test GET /health\n(HTTPS 443)
RENDER --> GHCR : kéo image theo tag SHA

BROWSER --> VERCEL : HTTPS 443\ntải giao diện
BROWSER --> RENDER : HTTPS 443 (REST + JWT)\nCORS chỉ cho domain Vercel
API --> DB : TCP 5432, Internal URL\n(không mở ra Internet)
ENV ..> API : biến môi trường
RENDER ..> API : health check GET /health\nlog -> Render Logs
@enduml
