@startuml deployment
' UML deployment diagram – môi trường production thực tế (Task 3.2) – TV1 Đào Duy Phong, TV6 Nguyễn Tấn Sự
' Production chính: AWS EC2 (Ubuntu + Docker Compose + Caddy) – ADR-007. Bản phụ: Vercel + Render – ADR-006.
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
skinparam nodeBorderColor #2F6B4F
skinparam nodeBackgroundColor #FFFFFF
skinparam artifactBorderColor #A86B12
skinparam databaseBorderColor #2F6B4F
skinparam ArrowColor #2F6B4F
skinparam rectangleBorderColor #8AA9A0
skinparam rectangleBorderStyle dashed
left to right direction

rectangle "LOCAL – máy lập trình viên / quản trị" as LOCAL {
  node "Laptop (Docker Desktop)" as DEV {
    artifact "Git repo\ndocker-compose.yml" as GIT
    artifact "brewlite-key.pem\n(key pair, không commit)" as PEM
  }
}

rectangle "CI – GitHub" as CI {
  node "GitHub Repository\n(PR bắt buộc)" as GH
  node "GitHub Actions runner\n(ubuntu-latest)" as RUNNER {
    artifact "ci.yml · e2e.yml" as CIWF
    artifact "cd.yml · rollback.yml\n(deploy-ec2: SSH)" as CDWF
  }
  node "GitHub Container Registry" as GHCR {
    artifact "brewlite-api:<sha>\nbrewlite-web:<sha>" as IMG
  }
  database "GitHub Secrets / Variables\nEC2_SSH_KEY · EC2_HOST · EC2_URL" as SECRETS
}

rectangle "PRODUCTION – AWS, region Singapore" as PROD {
  node "Thiết bị người dùng" as DEVICE {
    node "Trình duyệt / PWA" as BROWSER
  }
  node "EC2 t3.micro – Ubuntu 24.04\nIP công khai (Elastic IP)\nSecurity Group: 22, 80, 443" as EC2 {
    artifact "~~/brewlite (git clone)\ndocker-compose.prod.yml\ndeploy/deploy.sh · .env" as REPO
    node "Docker Engine (Docker Compose)" as DOCKER {
      node "proxy: Caddy 2\n:80 / :443, HTTPS Let's Encrypt\n<ip>.sslip.io" as CADDY
      node "web: Next.js 16\n:3000 (nội bộ)" as WEB
      node "api: NestJS\n:3001 (nội bộ)\nGET /health, log stdout\nprisma migrate deploy" as API
      database "db: PostgreSQL 16\n:5432 (nội bộ)\nvolume pgdata" as DB
    }
  }
}

rectangle "BẢN PHỤ (ADR-006)" as BACKUP {
  node "Vercel (web)" as VERCEL
  node "Render (API + PostgreSQL)" as RENDER
}

DEV --> GH : git push / Pull Request\n(HTTPS 443)
DEV ..> EC2 : SSH 22 bằng key pair\n(cài đặt lần đầu)
GH --> RUNNER : kích hoạt workflow
CDWF --> GHCR : docker push\n(HTTPS 443)
CDWF ..> SECRETS : đọc secret
CDWF --> EC2 : SSH 22: deploy.sh <sha>\nsmoke test /api/health
CDWF ..> BACKUP : Deploy Hook / vercel deploy
DOCKER --> GHCR : docker pull image :<sha>
REPO ..> DOCKER : docker compose up -d

BROWSER --> CADDY : HTTPS 443
CADDY --> WEB : /
CADDY --> API : /api/*
API --> DB : TCP 5432\n(không mở ra Internet)
@enduml
