# Mẫu biến môi trường cho server AWS EC2. deploy/setup-ec2.sh tự chép thành file .env ở thư mục gốc repo
# và tự sinh mật khẩu ngẫu nhiên. KHÔNG commit file .env (đã bị .gitignore chặn).

# Địa chỉ công khai của hệ thống ("Config IP"):
#   https://<IP-đổi-dấu-chấm-thành-gạch>.sslip.io  -> có HTTPS tự động. Vd IP 203.0.113.10 -> https://203-0-113-10.sslip.io
#   http://<IP>                                    -> chỉ HTTP. Vd http://203.0.113.10
PUBLIC_URL=https://203-0-113-10.sslip.io

# Chủ repo trên GitHub (chữ thường) – image lấy từ ghcr.io/<GHCR_OWNER>/brewlite-api và brewlite-web
GHCR_OWNER=duyphong-181006
# Commit SHA đang chạy – deploy/deploy.sh tự cập nhật, không cần sửa tay
IMAGE_TAG=latest

# Chỉ dùng chữ và số (mật khẩu nằm trong DATABASE_URL)
POSTGRES_PASSWORD=doi-mat-khau-nay
JWT_SECRET=doi-chuoi-bi-mat-nay
# Mã nhân viên cho màn quầy /staff
STAFF_KEY=doi-ma-nhan-vien

# true = nạp menu mẫu + tài khoản demo khi API khởi động (upsert, chạy lại không trùng)
RUN_SEED=true
MOCK_PAYMENT_DELAY_MS=300
