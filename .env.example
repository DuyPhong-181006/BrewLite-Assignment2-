# BrewLite – danh sách biến môi trường. Mỗi app có file mẫu riêng:
#   apps/api/.env.example  -> sao chép thành apps/api/.env
#   apps/web/.env.example  -> sao chép thành apps/web/.env.local
# KHÔNG commit file .env thật. Giá trị production nằm trong Render / Vercel / GitHub Secrets (xem docs/deployment.md).

# ---------- API (apps/api) ----------
DATABASE_URL="postgresql://brewlite:brewlite@localhost:5432/brewlite?schema=public"
JWT_SECRET="doi-chuoi-bi-mat-nay"
PORT=3001
FRONTEND_URL=""
MOCK_PAYMENT_DELAY_MS=300
# true = nạp menu mẫu khi API khởi động (upsert, chạy lại không trùng)
RUN_SEED=false

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------- Test ----------
# CSDL riêng cho integration test (docker compose tự tạo brewlite_test)
# Chạy test: đặt DATABASE_URL bằng giá trị này trước khi gọi npm run test:e2e
TEST_DATABASE_URL="postgresql://brewlite:brewlite@localhost:5432/brewlite_test?schema=public"
# Địa chỉ web cho Playwright
E2E_BASE_URL=http://localhost:3000
