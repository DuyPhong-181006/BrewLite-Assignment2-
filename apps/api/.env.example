# Sao chép thành apps/api/.env rồi sửa giá trị. KHÔNG commit file .env
DATABASE_URL="postgresql://brewlite:brewlite@localhost:5432/brewlite?schema=public"
# Chuỗi bí mật ký JWT – bắt buộc. Production đặt chuỗi dài ngẫu nhiên trong Render, không ghi vào repo
JWT_SECRET="doi-chuoi-bi-mat-nay"
PORT=3001
# Domain frontend được phép gọi API (cách nhau dấu phẩy). Để trống = cho phép tất cả (chỉ dùng local)
FRONTEND_URL=""
# Thời gian giả lập cổng thanh toán xử lý (ms)
MOCK_PAYMENT_DELAY_MS=300
